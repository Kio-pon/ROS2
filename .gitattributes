# Keep line endings sane across Windows/Linux checkouts.
# Shell scripts MUST stay LF or they fail on Linux with "bad interpreter: ^M".
* text=auto

*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
entrypoint.sh text eol=lf
.env        text eol=lf

# Binary assets — never touch.
*.pdf       binary
*.png       binary
*.jpg       binary
*.glb       binary
*.tif       binary
*.AppImage  binary
