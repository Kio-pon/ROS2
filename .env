# =============================================================================
#  Environment defaults for docker-compose (auto-loaded by `docker compose`).
#  Edit these instead of the compose file.
# =============================================================================

# --- Host user identity -------------------------------------------------------
# Match the container user to YOUR host user so X11 and bind-mounted files work
# without permission headaches. On Linux run:  echo "UID=$(id -u)" "GID=$(id -g)"
# and put the values here (1000/1000 is the typical first Linux user).
UID=1000
GID=1000

# --- Pinned upstream versions (the exact commits the project was built on) ----
# Override with `main` for bleeding edge, or a tag for a frozen release.
PX4_REF=183b3e38d5
PX4MSGS_REF=64775a2

# --- Build tuning -------------------------------------------------------------
# Parallel compile jobs for the PX4 build. Raise on a powerful PC (e.g. 8),
# lower to 2 on a low-RAM machine to avoid the compiler being OOM-killed.
BUILD_JOBS=4

# --- Runtime: which aircraft / world spawns -----------------------------------
PX4_SYS_AUTOSTART=4010
PX4_SIM_MODEL=gz_x500_mono_cam
PX4_GZ_WORLD=farmland

# --- ROS 2 --------------------------------------------------------------------
ROS_DOMAIN_ID=0

# Set to 1 to force Gazebo headless (no GUI) regardless of display.
HEADLESS=
