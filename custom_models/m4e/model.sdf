      <sensor name="m4e_wide" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>false</always_on>
        <update_rate>15</update_rate>
        <topic>/drone/camera/wide/image_raw</topic>
        <camera>
          <horizontal_fov>1.4661</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>500.0</far>
          </clip>
        </camera>
      </sensor>

      <sensor name="m4e_medium_tele" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>false</always_on>
        <update_rate>15</update_rate>
        <topic>/drone/camera/medium_tele/image_raw</topic>
        <camera>
          <horizontal_fov>0.6109</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>1000.0</far>
          </clip>
        </camera>
      </sensor>

     <sensor name="m4e_tele" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>false</always_on>
        <update_rate>15</update_rate>
        <topic>/drone/camera/tele/image_raw</topic>
        <camera>
          <horizontal_fov>0.2618</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>1.0</near>
            <far>2000.0</far>
          </clip>
        </camera>
      </sensor>

      <sensor name="lrf" type="gpu_lidar">
        <pose>0 0 0 0 1.5708 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>1</update_rate>
        <topic>/drone/lrf/range</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>1.0</min>
            <max>1800.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.1</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <joint name="gimbal_tilt_joint" type="revolute">
      <parent>gimbal_roll_link</parent>
      <child>camera_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1.570796</lower>
          <upper>0.610865</upper>
          <effort>10</effort>
          <velocity>1.7453</velocity>
        </limit>
        <dynamics>
          <damping>0.2</damping>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_yaw_joint</joint_name>
      <topic>/drone/gimbal/cmd/pan</topic>
      <p_gain>5</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.5</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_roll_joint</joint_name>
      <topic>/drone/gimbal/cmd/roll</topic>
      <p_gain>10</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>1.5</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_tilt_joint</joint_name>
