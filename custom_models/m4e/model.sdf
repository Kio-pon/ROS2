      <parent>gimbal_mount</parent>
      <child>gimbal_yaw_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit>
          <lower>-1.047198</lower>
          <upper>1.047198</upper>
          <effort>10</effort>
          <velocity>1.745</velocity>
        </limit>
        <dynamics>
          <damping>0.3</damping>
