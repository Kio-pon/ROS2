<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="spruce_tree">
    <static>true</static>
    <link name="link">
      <!-- glb node transforms already make this Z-up; no extra rotation (the
           original file's -90deg pitch tipped it over). ~17 m tall as-is. -->
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh><uri>model://spruce_tree/spruce_tree.glb</uri></mesh>
        </geometry>
      </visual>
      <!-- Collision: THIN cylinder over the trunk only, NOT the branches. The
           visual canopy is ~8.4 m wide, but a drone should be able to fly between
           the branches and only crash if it hits the actual trunk. Radius 0.4 m
           (~0.8 m trunk). Bump it up only if you want branch collisions back. -->
      <collision name="collision">
        <pose>0 0 8.7 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.4</radius><length>17.4</length></cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
