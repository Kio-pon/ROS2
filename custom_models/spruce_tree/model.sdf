<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="spruce_tree">
    <static>true</static>
    <link name="link">
      <!-- glb node transforms already make this Z-up; no extra rotation (the
           original file's -90deg pitch tipped it over). ~17 m tall as-is. -->
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh><uri>model://spruce_tree/spruce_tree.glb</uri></mesh>
        </geometry>
      </visual>
      <!-- Collision: cylinder over the trunk + dense inner canopy. Measured mesh
           extent is ~8.4 m wide x 17.4 m tall; radius here is the solid core, widen
           toward ~4.2 m if the drone clips outer branches. -->
      <collision name="collision">
        <pose>0 0 8.7 0 0 0</pose>
        <geometry>
          <cylinder><radius>2.5</radius><length>17.4</length></cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
