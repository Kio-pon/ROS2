<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Simple barn built from SDF primitives. Placed far from the wheat
       field so it's a distant landmark visible from drone altitude. -->
  <model name="barn">
    <static>true</static>
    <link name="link">
      <!-- Main body -->
      <visual name="body">
        <pose>0 0 2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box><size>8 5 4</size></box>
        </geometry>
        <material>
          <ambient>0.45 0.25 0.1 1</ambient>
          <diffuse>0.6 0.35 0.15 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Roof (tilted box) -->
      <visual name="roof">
        <pose>0 0 4.5 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box><size>9 6.5 0.8</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.12 0.08 1</ambient>
          <diffuse>0.65 0.18 0.1 1</diffuse>
          <specular>0.15 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Door -->
      <visual name="door">
        <pose>0 -2.51 1.2 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box><size>1.8 0.05 2.4</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.12 0.05 1</ambient>
          <diffuse>0.3 0.18 0.08 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <!-- Simple collision for the whole barn -->
      <collision name="collision">
        <pose>0 0 2.5 0 0 0</pose>
        <geometry>
          <box><size>9 6.5 5</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
