<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Low-poly wheat plant (~48 tris). Procedurally generated hexagonal
       stalk + ear + 4 leaves. ~0.8m tall, realistic for Pakistani wheat
       (60-120cm). Visual-only: the drone flies through crops. -->
  <model name="wheat_plant">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://wheat_plant/meshes/wheat_lowpoly.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.6 0.45 0.1 1</ambient>
          <diffuse>0.85 0.68 0.15 1</diffuse>
          <specular>0.1 0.1 0.05 1</specular>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
