<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="forest_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>200 200</size></plane>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <plane><normal>0 0 1</normal><size>200 200</size></plane>
        </geometry>
        <material>
          <diffuse>0.40 0.50 0.32 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://forest_terrain/bc_moss_rock_diffuse.png</albedo_map>
              <normal_map>model://forest_terrain/bc_moss_rock_normal.png</normal_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- ponytail: flat ground. The supplied heightmap is 256x256, but Gazebo
           needs 2^n+1 (e.g. 257) - so bumpy terrain is a follow-up step. -->
    </link>
  </model>
</sdf>
