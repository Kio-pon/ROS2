<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Irrigation canal / river strip. Visual-only blue water surface. -->
  <model name="river">
    <static>true</static>
    <link name="link">
      <visual name="water_surface">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box><size>80 3 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.3 0.6 0.8</ambient>
          <diffuse>0.15 0.4 0.7 0.85</diffuse>
          <specular>0.6 0.6 0.7 1</specular>
        </material>
      </visual>
      <!-- Shallow riverbed -->
      <visual name="riverbed">
        <pose>0 0 -0.08 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box><size>80 3.4 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.2 0.12 1</ambient>
          <diffuse>0.35 0.28 0.15 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
