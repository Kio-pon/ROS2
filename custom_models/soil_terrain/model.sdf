<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="soil_terrain">
    <static>true</static>
    <link name="link">
      <!-- Near-flat field: 1 m max height so crop rows stay roughly level.
           Reuses forest_terrain's heightmap PNG; texture is local brown soil. -->
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://forest_terrain/bc_terrain_heightmap_257.png</uri>
            <size>200 200 1</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://soil_terrain/soil_diffuse.png</diffuse>
              <normal>model://forest_terrain/bc_moss_rock_normal.png</normal>
              <size>4</size>
            </texture>
            <uri>model://forest_terrain/bc_terrain_heightmap_257.png</uri>
            <size>200 200 1</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
