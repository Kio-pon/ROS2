<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="wheat_terrain">
    <static>true</static>
    <link name="link">
      <!-- Green grass terrain for wheat field. Uses farmland_terrain's grass
           texture on top of the same heightmap. Max height 1m = nearly flat. -->
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://forest_terrain/bc_terrain_heightmap_257.png</uri>
            <size>200 200 1</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://farmland_terrain/grass_diffuse.png</diffuse>
              <normal>model://farmland_terrain/grass_normal.png</normal>
              <size>8</size>
            </texture>
            <uri>model://forest_terrain/bc_terrain_heightmap_257.png</uri>
            <size>200 200 1</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
