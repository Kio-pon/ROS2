<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="farmland_terrain">
    <static>true</static>
    <link name="link">
      <!-- size = footprint_x footprint_y max_height (m). Max 1.5 m = gentle
           rolling farmland, not bumpy forest. Reuses forest_terrain's heightmap;
           texture is a green grass field (see tools/gen_grass_texture.py). -->
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://forest_terrain/bc_terrain_heightmap_257.png</uri>
            <size>200 200 1.5</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://farmland_terrain/grass_diffuse.png</diffuse>
              <normal>model://farmland_terrain/grass_normal.png</normal>
              <size>8</size>
            </texture>
            <uri>model://forest_terrain/bc_terrain_heightmap_257.png</uri>
            <size>200 200 1.5</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
