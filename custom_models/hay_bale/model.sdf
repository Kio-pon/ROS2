<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="hay_bale">
    <static>true</static>
    <link name="link">
      <!-- round bale lying on its side: cylinder rotated 90deg about x.
           Pose z from place_on_terrain.py puts the axis ~0.7 m up. -->
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <pose>0 0 0.7 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.7</radius><length>1.4</length></cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.45 0.20 1</ambient>
          <diffuse>0.80 0.66 0.32 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
