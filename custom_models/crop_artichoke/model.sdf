<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Artichoke plant (~1.48 m). Mesh+textures from PIC4SeR/AutomaticRowCropGenerator
       (MIT) - see NOTICE. The "texture foglia.jpg" was renamed texture_foglia.jpg
       (spaces break OBJ/MTL loading) and the .mtl patched to match. Box collision +
       cast_shadows off for cheap many-instance rendering. -->
  <model name="crop_artichoke">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh><uri>model://crop_artichoke/meshes/carciofo1.obj</uri></mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0.74 0 0 0</pose>
        <geometry>
          <box><size>0.9 0.9 1.48</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
