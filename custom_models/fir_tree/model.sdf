<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="fir_tree">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <!-- fixed: original pointed at a non-existent mesh/fir_tree.glb -->
          <mesh><uri>model://fir_tree/lhpine.glb</uri></mesh>
        </geometry>
      </visual>
      <!-- Collision: THIN cylinder over the trunk only, NOT the branches. The
           visual canopy is ~25 m wide, but the old 7 m radius meant the drone
           "crashed out of nowhere" while still metres away from anything solid.
           Radius 0.9 m (~1.8 m trunk for a big pine). Bump up only if you want
           branch collisions back. -->
      <collision name="collision">
        <pose>0 0 26.5 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.9</radius><length>53.0</length></cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
